# =============================================================================
# AIECS Office MCP Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values as needed.


# =============================================================================
# MCP Server Configuration
# =============================================================================
MCP_HOST=0.0.0.0
MCP_PORT=5040

# =============================================================================
# DocumentServer (ONLYOFFICE) Configuration
# =============================================================================
DOCUMENTSERVER_URL=http://localhost:8000
DOCUMENTSERVER_JWT_SECRET=
DOCUMENTSERVER_JWT_IN_BODY=true

# =============================================================================
# Document Builder script-to-url (when script provided instead of url)
# =============================================================================
# Option A: GCS path for temp .docbuilder files (gs://bucket/path)
# DOCBUILDER_SCRIPT_GCS_PATH=gs://my-bucket/temp/docbuilder
# Option B: MCP server public URL (Document Server must reach this)
# MCP_PUBLIC_URL=http://host:5040

# =============================================================================
# =============================================================================
# MinIO / S3-compatible Storage (s3:// paths for office tools)
# =============================================================================
# DocumentServer fetches objects via presigned HTTP URLs generated by MCP.
MINIO_ENDPOINT=http://100.81.172.125:9000
MINIO_PUBLIC_ENDPOINT=http://100.81.172.125:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=chatbot-use
MINIO_FORCE_PATH_STYLE=true
# proxy (default when MCP_PUBLIC_URL set): DocumentServer fetches via MCP /storage-objects/
MINIO_FETCH_MODE=proxy

# GCS Storage (for gs:// paths)
# =============================================================================
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

MCP_LOG_LEVEL=info

# Enable OpenAI function calling format endpoint at /openai/v1/tools
MCP_ENABLE_OPENAI_FORMAT=true

# Optional: Concurrency and rate limiting
# MCP_MAX_REQUESTS_PER_SECOND=100
# MCP_MAX_CONCURRENT_REQUESTS=100
# MCP_REQUEST_BURST_SIZE=200


# =============================================================================
# Tool Executor Configuration (Caching)
# =============================================================================
TOOL_EXECUTOR_ENABLE_CACHE=true
TOOL_EXECUTOR_CACHE_SIZE=200
TOOL_EXECUTOR_CACHE_TTL=7200

# Dual-layer cache (L1: LRU + L2: Redis)
TOOL_EXECUTOR_ENABLE_DUAL_CACHE=true
TOOL_EXECUTOR_ENABLE_REDIS_CACHE=true
TOOL_EXECUTOR_REDIS_CACHE_TTL=86400
TOOL_EXECUTOR_L1_CACHE_TTL=300


# =============================================================================
# Redis Configuration
# =============================================================================
# Required for distributed caching when TOOL_EXECUTOR_ENABLE_REDIS_CACHE=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Alternative: Full Redis URL (takes precedence over REDIS_HOST/PORT/DB/PASSWORD)
# REDIS_URL=redis://:password@localhost:6379/1

# Optional: Redis SSL/TLS for secure connections
# REDIS_SSL=false
# REDIS_SSL_CERT_REQS=required


# =============================================================================
# Logging
# =============================================================================
LOG_DIR=./logs
PYTHONUNBUFFERED=1
