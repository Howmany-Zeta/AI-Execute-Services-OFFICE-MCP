# =============================================================================
# AIECS Office MCP — Test Environment (.env.test)
# =============================================================================
# Copy to `.env.test` and adjust for your test / E2E environment.
# All pytest runs load this file via tests/conftest.py (see tests/env_test.py).

# =============================================================================
# DocumentServer
# =============================================================================
DOCUMENTSERVER_URL=http://localhost:8000
DOCUMENTSERVER_JWT_SECRET=
DOCUMENTSERVER_JWT_IN_BODY=true

# =============================================================================
# MCP Server
# =============================================================================
MCP_HOST=0.0.0.0
MCP_PORT=5040
MCP_PUBLIC_URL=http://127.0.0.1:5040
MCP_LOG_LEVEL=info
MCP_ENABLE_OPENAI_FORMAT=true

# =============================================================================
# MinIO / S3 (s3:// paths for office tools)
# =============================================================================
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_PUBLIC_ENDPOINT=http://127.0.0.1:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=chatbot-use
MINIO_FORCE_PATH_STYLE=true
MINIO_FETCH_MODE=proxy

# =============================================================================
# GCS (optional, for gs:// paths)
# =============================================================================
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# DOCBUILDER_SCRIPT_GCS_PATH=gs://my-bucket/temp/docbuilder

# =============================================================================
# Redis (optional for integration tests)
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

TOOL_EXECUTOR_ENABLE_CACHE=true
TOOL_EXECUTOR_ENABLE_DUAL_CACHE=false
TOOL_EXECUTOR_ENABLE_REDIS_CACHE=false

LOG_DIR=./logs
PYTHONUNBUFFERED=1

# =============================================================================
# E2E Test paths (pytest -m e2e)
# =============================================================================
E2E_MCP_URL=http://127.0.0.1:5040
# DocumentServer-reachable URL for docbuilder script fetch (overrides MCP_PUBLIC_URL in tests)
E2E_MCP_PUBLIC_URL=http://127.0.0.1:5040

E2E_SOURCE_PATH=s3://chatbot-use/path/to/document.docx
E2E_MINIO_SOURCE_PATH=s3://chatbot-use/path/to/document.docx
E2E_SOURCE_PATHS=s3://chatbot-use/path/to/document.docx,s3://chatbot-use/path/to/document2.docx

# Spreadsheet-specific (optional; falls back to E2E_SOURCE_PATH / E2E_SOURCE_PATHS)
E2E_SPREADSHEET_SOURCE_PATH=s3://chatbot-use/path/to/workbook.xlsx
E2E_SPREADSHEET_SOURCE_PATHS=s3://chatbot-use/path/to/workbook.xlsx,s3://chatbot-use/path/to/workbook2.xlsx

E2E_TEMPLATE_PATH=s3://chatbot-use/path/to/template.docx

# Optional pre-hosted builder script URL
# E2E_DOCBUILDER_URL=

# Legacy GCS aliases (optional)
# E2E_GCS_SOURCE_PATH=gs://bucket/path/file.docx
# E2E_GCS_SOURCE_PATHS=gs://bucket/a.docx,gs://bucket/b.docx
# E2E_GCS_TEMPLATE_PATH=gs://bucket/template.docx
