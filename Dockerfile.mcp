# MCP Server Dockerfile — production multi-stage build
# Runtime connects to external infra only (DocumentServer, Redis, MinIO/GCS via env).

# ============================================================================
# Stage 1: compile Python wheels / install dependencies
# ============================================================================
FROM python:3.11-slim AS builder

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    DEBIAN_FRONTEND=noninteractive \
    POETRY_VIRTUALENVS_CREATE=false \
    POETRY_NO_INTERACTION=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir "poetry>=2.0.0,<3.0.0"

WORKDIR /app
COPY pyproject.toml poetry.lock ./
RUN poetry install --only=main --no-ansi --no-root

# ============================================================================
# Stage 2: production runtime (no build toolchain, no infra services)
# ============================================================================
FROM python:3.11-slim AS production

ARG APP_VERSION=0.0.0
ARG GIT_SHA=unknown
ARG BUILD_DATE=unknown

LABEL org.opencontainers.image.title="aiecs-office-mcp" \
      org.opencontainers.image.description="AIECS Office MCP Server - Document Tools" \
      org.opencontainers.image.vendor="AIECS Team" \
      org.opencontainers.image.version="${APP_VERSION}" \
      org.opencontainers.image.revision="${GIT_SHA}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.source="https://github.com/Howmany-Zeta/AI-Execute-Services-OFFICE-MCP" \
      maintainer="AIECS Team"

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    APP_VERSION=${APP_VERSION} \
    GIT_SHA=${GIT_SHA}

# Runtime-only OS deps (none required for current wheel set; keep image minimal)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Non-root service account
RUN groupadd --gid 1000 appuser \
    && useradd --uid 1000 --gid 1000 --create-home --shell /usr/sbin/nologin appuser

WORKDIR /app

# Python packages from builder (no Poetry in final image)
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Application code only (no postgres/redis/documentserver/minio binaries)
COPY aiecs/mcp/ ./aiecs/mcp/
COPY aiecs/tools/base_tool.py ./aiecs/tools/
COPY aiecs/tools/schema_generator.py ./aiecs/tools/
COPY aiecs/tools/office_tool/ ./aiecs/tools/office_tool/
COPY aiecs/clients/ ./aiecs/clients/
COPY aiecs/tools/tool_executor/ ./aiecs/tools/tool_executor/
COPY aiecs/tools/__init__.py ./aiecs/tools/
COPY aiecs/utils/ ./aiecs/utils/
RUN mkdir -p ./aiecs/infrastructure/persistence
COPY aiecs/infrastructure/persistence/redis_client.py ./aiecs/infrastructure/persistence/
COPY aiecs/infrastructure/persistence/__init__.py ./aiecs/infrastructure/persistence/
RUN echo 'from .persistence import redis_client\n__all__ = ["redis_client"]' > ./aiecs/infrastructure/__init__.py
COPY aiecs/config/ ./aiecs/config/
COPY aiecs/main_mcp.py ./aiecs/
COPY aiecs/__init__.py ./aiecs/

RUN mkdir -p /app/logs \
    && chown -R appuser:appuser /app

USER appuser

EXPOSE 5040

HEALTHCHECK --interval=30s --timeout=15s --start-period=120s --retries=3 \
    CMD python -c "import requests; r=requests.get('http://127.0.0.1:5040/health', timeout=15); r.raise_for_status(); d=r.json(); assert d.get('documentserver_reachable') is True, d" || exit 1

CMD ["python", "-m", "aiecs.main_mcp"]
